@UserManagementAPI_HostAddress = http://localhost:5112

### ============================================
### PRUEBAS DE MIDDLEWARE DE LOGGING Y EXCEPCIONES
### ============================================

### 1. GET: Obtener todos los usuarios (paginación válida)
# Respuesta esperada: 200 OK
# Middleware: Registra duración y status code
GET {{UserManagementAPI_HostAddress}}/api/users?page=1&pageSize=10
Accept: application/json

###

### 2. GET: Obtener todos los usuarios (sin parámetros - valores por defecto)
# Respuesta esperada: 200 OK
GET {{UserManagementAPI_HostAddress}}/api/users
Accept: application/json

###

### 3. GET: Paginación inválida (page negativo)
# Respuesta esperada: 400 Bad Request
# Activa validación en handler
GET {{UserManagementAPI_HostAddress}}/api/users?page=0&pageSize=10
Accept: application/json

###

### 4. GET: Paginación inválida (pageSize excede límite)
# Respuesta esperada: 400 Bad Request
# Activa validación de pageSize máximo
GET {{UserManagementAPI_HostAddress}}/api/users?page=1&pageSize=150
Accept: application/json

###

### 5. GET: Obtener usuario por ID válido
# Respuesta esperada: 404 Not Found (DB vacía inicialmente)
GET {{UserManagementAPI_HostAddress}}/api/users/1
Accept: application/json

###

### 6. GET: Obtener usuario por ID inválido (ID negativo)
# Respuesta esperada: 400 Bad Request
GET {{UserManagementAPI_HostAddress}}/api/users/-1
Accept: application/json

###

### 7. GET: Obtener usuario por ID cero
# Respuesta esperada: 400 Bad Request
GET {{UserManagementAPI_HostAddress}}/api/users/0
Accept: application/json

###

### 8. POST: Crear usuario válido
# Respuesta esperada: 201 Created con Location header
# Middleware: Registra petición POST exitosa
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Juan Pérez",
  "email": "juan.perez@example.com"
}

###

### 9. POST: Crear segundo usuario para pruebas
# Respuesta esperada: 201 Created
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "María García",
  "email": "maria.garcia@example.com"
}

###

### 10. POST: Crear usuario con email duplicado
# Respuesta esperada: 400 Bad Request
# Activa InvalidOperationException capturada en handler
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Juan Duplicado",
  "email": "juan.perez@example.com"
}

###

### 11. POST: Crear usuario con nombre vacío
# Respuesta esperada: 400 Bad Request
# Activa validación de validator
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "",
  "email": "test@example.com"
}

###

### 12. POST: Crear usuario con nombre muy corto
# Respuesta esperada: 400 Bad Request
# Activa validación de longitud mínima (MIN_NAME_LENGTH = 2)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "A",
  "email": "test2@example.com"
}

###

### 13. POST: Crear usuario con nombre muy largo
# Respuesta esperada: 400 Bad Request
# Activa validación de longitud máxima (MAX_NAME_LENGTH = 100)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "NombreMuyLargoQueExcedeLosLimites123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890",
  "email": "test3@example.com"
}

###

### 14. POST: Crear usuario con nombre con caracteres inválidos
# Respuesta esperada: 400 Bad Request
# Activa validación de NameRegex
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Juan@Pérez#",
  "email": "test4@example.com"
}

###

### 15. POST: Crear usuario con nombre solo números
# Respuesta esperada: 400 Bad Request
# Activa validación de regex @"^\d+$"
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "12345",
  "email": "test5@example.com"
}

###

### 16. POST: Crear usuario con nombre con espacios múltiples
# Respuesta esperada: 400 Bad Request
# Activa validación de espacios múltiples
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Juan    Pérez",
  "email": "test6@example.com"
}

###

### 17. POST: Crear usuario con email vacío
# Respuesta esperada: 400 Bad Request
# Activa validación de email vacío
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "name": "Test Usuario",
  "email": ""
}

###

### 18. POST: Crear usuario con email inválido (sin @)
# Respuesta esperada: 400 Bad Request
